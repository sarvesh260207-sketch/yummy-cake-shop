# Add these in Vercel -> Project -> Settings -> Environment Variables (never commit real values)

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=en

# Database (added automatically when you connect Upstash Redis from the Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login OTP by EMAIL (Brevo free plan: 300 emails/day)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=     # a sender you verified in Brevo
BREVO_SENDER_NAME=Yummy Cakes
ADMIN_EMAIL=            # where the login code is delivered

# Optional alternatives: SMS via Fast2SMS (paid) or WhatsApp
FAST2SMS_API_KEY=
FAST2SMS_DLT_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=
# Force a channel: email | sms | whatsapp (default: first one configured)
OTP_CHANNEL=

# Admin login
ADMIN_PHONE=           # your mobile, e.g. 9876543210
SESSION_SECRET=        # 40+ random characters
