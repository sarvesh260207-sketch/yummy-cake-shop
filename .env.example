# Add these in Vercel -> Project -> Settings -> Environment Variables (never commit real values)

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=order_confirmation
WHATSAPP_TEMPLATE_LANG=en

# Database (added automatically when you connect Upstash Redis from the Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin login OTP by SMS (Fast2SMS)
FAST2SMS_API_KEY=
# Optional, only after DLT registration (faster than Quick SMS):
FAST2SMS_DLT_SENDER_ID=
FAST2SMS_DLT_MESSAGE_ID=
# Optional: set to "whatsapp" to send the OTP on WhatsApp instead
OTP_CHANNEL=

# Admin login
ADMIN_PHONE=           # your mobile, e.g. 9876543210
SESSION_SECRET=        # 40+ random characters
